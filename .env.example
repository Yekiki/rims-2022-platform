# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rims_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=rims
# Set to true only if your MySQL provider requires TLS.
MYSQL_SSL=false

# Generate a random secret of at least 32 characters for signed HttpOnly sessions.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Admin bootstrap (run: npm run grant-admin)
ADMIN_USERNAME=researcher
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_FULL_NAME=پژوهشگر

# Only for the one-time data migration from Supabase to MySQL.
# Use the old project URL and server-only service-role key for the migration script only.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_OLD_SERVICE_ROLE_KEY
# If multiple admin profiles exist in Supabase, specify which one receives the credentials:
# ADMIN_USER_ID=existing-admin-uuid

# Optional temporary bridge so users with an old Supabase browser session can transfer it once.
# Keep these only during the transition; remove them after users have opened the new app.
# LEGACY_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# LEGACY_SUPABASE_ANON_KEY=YOUR_OLD_SUPABASE_ANON_KEY
# NEXT_PUBLIC_LEGACY_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_LEGACY_SUPABASE_ANON_KEY=YOUR_OLD_SUPABASE_ANON_KEY
